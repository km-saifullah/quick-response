{
  "name": "quick-response",
  "version": "2.0.0",
  "description": "A tiny, dependency-free, fully-typed utility for building consistent, structured API responses in Node.js applications.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsup && node scripts/fix-cjs.cjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "audit:check": "npm audit --omit=dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/km-saifullah/quick-response.git"
  },
  "author": "Khaled Md Saifullah",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/km-saifullah/quick-response/issues"
  },
  "keywords": [
    "javascript",
    "typescript",
    "nodejs",
    "api",
    "api-response",
    "quick-response",
    "apiResponse",
    "express",
    "rest-api"
  ],
  "homepage": "https://github.com/km-saifullah/quick-response#readme",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsup": "^8.5.1",
    "typescript": "^5.6.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
